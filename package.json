{
  "name": "lean-to-cook",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "bun --filter @repo/web build-storybook",
    "dev": "turbo run dev",
    "storybook": "bun --filter @repo/web storybook",
    "test": "turbo run test",
    "test:e2e": "bun --filter @repo/web test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "quality": "turbo run quality",
    "knip": "knip",
    "sync-how-to-cook": "bun scripts/sync-how-to-cook.ts",
    "generate-source-proofs": "bun scripts/generate-source-recipe-proofs.ts",
    "check-source-coverage": "bun scripts/check-source-recipe-coverage.ts",
    "sync-skills": "bunx skills add https://github.com/forge-town/skills",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "check-circular": "madge --circular packages/*/src/index.ts",
    "deps-graph": "madge --image packages-dependency-graph.svg packages/*/src/index.ts",
    "deps-graph-png": "madge --image packages-dependency-graph.png packages/*/src/index.ts",
    "db:migrate": "bun --env-file=.env packages/db/src/integrations/migrate.ts",
    "db:seed": "bun --env-file=.env scripts/seed-catalog.ts",
    "dev:admin": "bun --filter @repo/admin dev",
    "dev:api": "bun --filter @repo/api dev",
    "format:check": "oxfmt --check packages/db-schema/src packages/db/src packages/models/src packages/services/src apps/api/src apps/admin/src packages/schemas/src/catalog",
    "admin:setup-password": "bun scripts/setup-admin-password.ts",
    "db:setup": "bun scripts/setup-catalog.ts",
    "admin:password": "bun scripts/change-admin-password.ts",
    "test:admin:e2e": "bun --cwd apps/admin x playwright test",
    "build:admin-storybook": "bun --filter @repo/admin build-storybook",
    "catalog:link-ingredients": "bun --env-file=.env scripts/link-recipe-ingredients.ts",
    "catalog:check-lean": "bun --env-file=.env scripts/check-catalog-lean.ts",
    "check-anatomy": "bun run --bun anatomy packages/lean-proofs --bundle anatomy.json --git-files",
    "generate-lean-metadata": "bun scripts/generate-lean-metadata.ts",
    "check-lean-contracts": "bun scripts/check-lean-contracts.ts",
    "test:lean-architecture": "bun test scripts/lean-architecture.test.ts scripts/lean-contracts.test.ts scripts/lean-checker.test.ts",
    "check-lean-scripts": "tsc -p tsconfig.lean-scripts.json"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@oxlint/binding-darwin-arm64": "^1.59.0",
    "@rollup/rollup-darwin-arm64": "^4.60.1",
    "anatomy-cli": "0.0.4",
    "drizzle-orm": "^0.45.2",
    "knip": "^6.4.0",
    "madge": "^8.0.0",
    "neverthrow": "8.2.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.59.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.21",
    "typescript": "5.9.2",
    "@types/bun": "^1.3.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}
