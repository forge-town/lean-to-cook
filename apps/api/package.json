{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/router.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/serve.ts",
    "build": "bun build src/serve.ts --target=bun --outdir dist --packages external",
    "start": "bun --env-file=../../.env dist/serve.js",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ./.oxlintrc.json src/",
    "test": "vitest run",
    "quality": "bun run check-types && bun run lint && bun run test"
  },
  "dependencies": {
    "@repo/services": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@trpc/server": "^11.16.0",
    "zod": "^4.3.6",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.11",
    "typescript": "5.9.2",
    "vitest": "^4.1.4"
  }
}
