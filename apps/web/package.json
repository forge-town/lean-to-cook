{
  "name": "@repo/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 7201 --host 127.0.0.1",
    "build": "vite build",
    "build-storybook": "storybook build",
    "serve": "vite preview --port 7201 --host 127.0.0.1",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "bun run build && playwright test",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ./.oxlintrc.json src/",
    "format": "oxfmt --config node_modules/@repo/oxc-formatter-config/oxfmt.json --write src/",
    "format:check": "oxfmt --config node_modules/@repo/oxc-formatter-config/oxfmt.json src/",
    "quality": "bun run check-types && bun run lint && bun run format:check && bun run test",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@repo/lean-proofs": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.7",
    "@tanstack/react-start": "^1.167.12",
    "@tanstack/router-plugin": "^1.167.8",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12",
    "@refinedev/core": "^5.0.12",
    "@trpc/client": "^11.16.0",
    "@repo/api": "workspace:*",
    "lucide-react": "1.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@repo/oxc-formatter-config": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "^30.1.3",
    "nitro": "3.0.260429-beta",
    "oxfmt": "^0.52.0",
    "storybook": "^10.5.10",
    "typescript": "5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.4"
  }
}
