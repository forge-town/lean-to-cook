    "@repo/api": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/router-plugin": "1.168.32",
    "@trpc/client": "^11.16.0",
    "lucide-react": "^1.7.0",
    "neverthrow": "^8.2.0",
