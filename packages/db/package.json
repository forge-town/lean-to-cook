{
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ./.oxlintrc.json src/",
    "test": "vitest run --passWithNoTests",
    "quality": "bun run check-types && bun run lint && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/integrations/migrate.ts"
  },
  "dependencies": {
    "@repo/db-schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.11",
    "typescript": "5.9.2",
    "vitest": "^4.1.4",
    "drizzle-kit": "^0.31.10"
  }
}
